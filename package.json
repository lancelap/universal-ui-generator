{
  "name": "universal-ui-generator",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "uig": "node --import tsx apps/cli/src/main.ts",
    "test": "vitest run",
    "test:qwen-extension": "vitest run extensions/qwen-cli/tests",
    "test:acceptance": "vitest run apps/cli/src/offline-acceptance.test.ts apps/cli/src/react-generation-acceptance.test.ts",
    "generate:react-acceptance-candidates": "node --import tsx scripts/generate-react-acceptance-candidates.ts",
    "build:qwen-extension": "node --import tsx scripts/build-qwen-extension.ts",
    "typecheck": "tsc --project tsconfig.base.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:fixtures": "node --import tsx scripts/verify-fixture-provenance.ts",
    "verify:qwen-extension-bundle": "node --import tsx scripts/verify-qwen-extension-bundle.ts",
    "verify": "pnpm format:check && pnpm typecheck && pnpm verify:fixtures && pnpm verify:qwen-extension-bundle && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "0.28.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
